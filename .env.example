APP_NAME="ESoft Learn"
APP_ENV=development
LOG_LEVEL=debug
APP_TIMEZONE=UTC

BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0
BACKEND_URL="http://localhost:3000"
BACKEND_PUBLIC_URL="http://localhost:3000"
BACKEND_API_PREFIX=/api

# openssl rand -base64 32
BACKEND_JWT_SECRET=
BACKEND_JWT_EXPIRES_IN=3600
BACKEND_JWT_REFRESH_SECRET=
BACKEND_JWT_REFRESH_EXPIRES_IN=604800

DB_HOST=postgres
DB_PORT=5432
DB_USER=user
DB_PASSWORD=tiger
DB_NAME=esoft_db
DATABASE_URL="postgresql://user:tiger@postgres:5432/esoft_db"
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_FROM="ESoft Learn <noreply@esoft.dev>"
MAIL_USER=
MAIL_PASS=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# HTTP(S)-прокси для доступа к api.telegram.org (пусто = напрямую)
TELEGRAM_PROXY_URL=

VITE_PORT=3001
VITE_URL="http://localhost:3001"

VITE_API_URL="http://localhost:3000/api"
VITE_API_TIMEOUT=30000

VITE_USE_MOCKS=false
VITE_ENABLE_DEVTOOLS=true

CORS_ORIGIN="http://localhost:3001"
CORS_METHODS="GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS"
CORS_ALLOWED_HEADERS="Content-Type,Authorization"
CORS_EXPOSED_HEADERS=
CORS_MAX_AGE=86400
CORS_CREDENTIALS=true
