{
  "name": "@repo/ui",
  "version": "0.0.1",
  "private": true,
  "author": "kyzne4ik",
  "type": "module",
  "exports": {
    "./*": "./src/*.tsx"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,scss,json,md}\""
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.13.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "peerDependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
